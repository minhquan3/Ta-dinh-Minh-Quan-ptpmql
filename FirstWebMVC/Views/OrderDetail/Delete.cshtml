@model FirstWebMVC.Models.OrderDetail

<h2>Xóa chi tiết đơn hàng</h2>
<p>Bạn có chắc muốn xóa chi tiết đơn hàng: 
    <strong>Đơn hàng @Model.OrderID - Sản phẩm @Model.ProductID</strong>?</p>
<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="OrderDetailID" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
