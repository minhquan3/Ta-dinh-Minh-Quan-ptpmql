@model IEnumerable<FirstWebMVC.ViewModels.StudentFacultyViewModel>

<h2>Danh sách sinh viên và khoa</h2>
<a asp-action="Create">Thêm mới</a>
<table border="1">
    <tr>
        <th>Mã SV</th>
        <th>Họ tên</th>
        <th>Khoa</th>
        <th>Hành động</th>
    </tr>
@foreach (var s in Model)
{
    <tr>
        <td>@s.StudentCode</td>
        <td>@s.FullName</td>
        <td>@s.FacultyName</td>
        <td>
            <a asp-action="Edit" asp-route-id="@s.StudentCode">Sửa</a> |
            <a asp-action="Delete" asp-route-id="@s.StudentCode">Xóa</a>
        </td>
    </tr>
}
</table>
