@model FirstWebMVC.Models.Student

<h2>Sửa sinh viên</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <label>Mã SV:</label>
    <input asp-for="StudentCode" /><br />
    <label>Họ tên:</label>
    <input asp-for="FullName" /><br />
    <button type="submit">Cập nhật</button>
</form>
